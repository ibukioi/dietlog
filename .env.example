# ローカルは file:local.db、本番は Turso の libsql://... URL
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# openssl rand -base64 32 などで生成
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Vercel Cron からの呼び出し保護
CRON_SECRET=
# お試しモード作成のレート制限で IP をハッシュ化するソルト
IP_HASH_SALT=
# Open Food Facts へ送る User-Agent(アプリ名/バージョン + リポジトリURL)
OFF_USER_AGENT=dietlog/0.1 (+https://github.com/<you>/dietlog)
# GitHub OAuth(本登録。未設定なら本登録ボタンは無効)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vercel Blob(商品写真。未設定なら写真アップロードは無効)
BLOB_READ_WRITE_TOKEN=
# お試しユーザー作成の上限(1 IP・1時間あたり)。本番は 5
GUEST_CREATE_LIMIT_PER_HOUR=5
